{
  "name": "evacuation-plan-editor",
  "version": "1.0.0-alpha.1",
  "description": "Free-to-use application for creating evacuation plans",
  "author": "Kaixotwentytwo",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron dist/main/index.js",
    "dev:renderer": "webpack --config webpack.config.js --watch",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main/index.js",
    "dev": "concurrently -n \"RENDER,MAIN\" -c \"cyan,yellow\" \"npm run dev:renderer\" \"npm run dev:main\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.fabric-editor.app",
    "productName": "Evacuation Plan Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/fabric/**"
    ],
    "electronLanguages": [
      "en",
      "ru"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Graphics"
    }
  },
  "dependencies": {
    "fabric": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "css-loader": "^7.1.4",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
